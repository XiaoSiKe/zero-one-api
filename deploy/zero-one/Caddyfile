{
	email {$ACME_EMAIL}
	servers {
		max_header_size 64kb
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

import Caddyfile.shared

(access_log) {
	log {
		output stdout
		format json
	}
}

api.01yapi.com {
	import access_log
	import landing_routes
}

app.01yapi.com {
	import access_log
	header Cache-Control "no-store"
	redir https://api.01yapi.com{uri} 308
}

01yapi.com, www.01yapi.com {
	import access_log
	redir https://api.01yapi.com{uri} 308
}
