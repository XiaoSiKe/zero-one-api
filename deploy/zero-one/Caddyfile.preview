{
	auto_https off
	servers {
		max_header_size 64kb
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

import Caddyfile.shared

:80 {
	@preview_console_pages {
		method GET HEAD
		path /setup /home /login /register /email-verify /auth/* /forgot-password /reset-password /key-usage /legal/* /model-plaza /dashboard /keys /batch-image /usage /redeem /affiliate /available-channels /profile /subscriptions /purchase /orders /payment/* /admin /admin/* /monitor
	}
	header @preview_console_pages >Content-Security-Policy "default-src 'self'; worker-src 'self' blob:; script-src 'self' 'nonce-hJm3vqvOCSJtMiorHL9OJA=='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src http: https:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	import landing_routes
}
